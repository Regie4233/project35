# This .gitignore file should be placed at the root of your Unity project.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get huge
/[Mm]emoryCaptures/

# Recordings can get huge
/[Rr]ecordings/

# Assets can also contain some high-level build artifacts
/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.db
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file usage statistics
sysinfo.txt

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# WebGL related
Release/
Compressed/

# Android related
*.apk
*.aab
*.unitypackage

# Apple related
*.plist
*.xcworkspace
*.xcscheme
*.app
*.ipa
*.framework

# Crashlytics generated file
crashlytics-build.properties

# Packer related
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# Ignore large machine learning models and documents
*.onnx
*.pdf

# Python and AI Terrain Generator
.venv/
__pycache__/
*.raw
*.h5
*.jpg
